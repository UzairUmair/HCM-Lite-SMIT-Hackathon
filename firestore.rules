rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && userData().active == true && userData().role == request.auth.token.role; }
    function roleIs(role) { return active() && request.auth.token.role == role; }
    function staff() { return roleIs('admin') || roleIs('hr'); }
    function owner(uid) { return active() && request.auth.uid == uid; }
    function belongs() { return resource.data.companyId == 'default'; }
    function validCompany(data) { return data.companyId == 'default'; }

    match /users/{uid} {
      allow get: if owner(uid) || roleIs('admin');
      allow list: if roleIs('admin');
      allow create, update, delete: if false;
    }
    match /companies/{id} {
      allow read: if active() && id == 'default';
      allow write: if false;
    }
    match /departments/{id} {
      allow get: if active() && belongs();
      allow list: if active();
      allow create: if roleIs('admin') && validCompany(request.resource.data);
      allow update: if roleIs('admin') && belongs() && validCompany(request.resource.data) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','code','status','updatedAt']);
      allow delete: if roleIs('admin') && belongs();
    }
    match /designations/{id} {
      allow get: if active() && belongs();
      allow list: if active();
      allow create: if roleIs('admin') && validCompany(request.resource.data);
      allow update: if roleIs('admin') && belongs() && validCompany(request.resource.data) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','departmentId','status','updatedAt']);
      allow delete: if roleIs('admin') && belongs();
    }
    match /holidays/{id} {
      allow get: if active() && belongs();
      allow list: if active();
      allow create: if roleIs('admin') && validCompany(request.resource.data);
      allow update: if roleIs('admin') && belongs() && validCompany(request.resource.data) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','date','updatedAt']);
      allow delete: if roleIs('admin') && belongs();
    }
    match /leave_policies/{id} {
      allow get: if active() && belongs();
      allow list: if active();
      allow create: if roleIs('admin') && validCompany(request.resource.data);
      allow update: if roleIs('admin') && belongs() && validCompany(request.resource.data) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['annual','sick','casual','unpaid','updatedAt']);
      allow delete: if false;
    }
    match /employees/{id} {
      allow get: if staff() && belongs() || owner(resource.data.uid);
      allow list: if staff();
      allow update: if owner(resource.data.uid) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['phone','address','updatedAt']);
      allow create, delete: if false;
    }
    match /salary_records/{id} {
      allow read: if staff();
      allow write: if false;
    }
    match /attendance/{id} {
      allow get: if staff() && belongs() || owner(resource.data.uid);
      allow list: if staff() || active() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /attendance_corrections/{id} {
      allow get: if staff() && belongs() || owner(resource.data.uid);
      allow list: if staff() || active() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /leaves/{id} {
      allow get: if staff() && belongs() || owner(resource.data.uid);
      allow list: if staff() || active() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /payroll_runs/{id} {
      allow read: if staff();
      allow write: if false;
    }
    match /payslips/{id} {
      allow get: if staff() && belongs() || owner(resource.data.uid);
      allow list: if staff() || active() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /announcements/{id} {
      allow get: if active() && belongs();
      allow list: if active();
      allow create, update, delete: if false;
    }
    match /notifications/{id} {
      allow get: if owner(resource.data.uid);
      allow list: if active() && resource.data.uid == request.auth.uid;
      allow update: if owner(resource.data.uid) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }
    match /audit_logs/{id} {
      allow read: if roleIs('admin');
      allow write: if false;
    }
    match /ai_logs/{id} {
      allow read: if roleIs('admin');
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
